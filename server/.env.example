MONGODB_URI=mongodb://localhost:27017/hathap
PORT=4000

# REQUIRED. JWT signing secret for auth. Generate a strong random value
# (>= 16 chars), e.g. `openssl rand -base64 48`. Production refuses to start
# without it — there is no default secret. Rotate it if it was ever committed.
# Development falls back to a non-secret value only when this is unset.
JWT_SECRET=replace_this_with_a_secure_random_string

# REQUIRED. 32+ character secret for AES-256-GCM encryption of stored API keys
# at rest. Must stay consistent across restarts or stored keys become
# unreadable. Rotate it if it was ever committed.
API_KEY_ENCRYPTION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# CORS allow-list for cross-origin browser requests, comma-separated.
# REQUIRED in production when the client is served from a different origin
# than the API (e.g. https://app.example.com). When unset: development allows
# the Vite dev-server origins (http://localhost:5173), production allows only
# same-origin requests.
# CORS_ORIGINS=https://app.example.com

# A2A (Agent-to-Agent) protocol
A2A_BASE_URL=http://localhost:4000
# Optional service auth: set both to allow X-A2A-API-Key access without JWT
# A2A_API_KEY=your-secret-a2a-key
# A2A_DEFAULT_USER_ID=mongodb-user-id-for-service-account

# ---- Real web research (Phase 11) ----
# Research provider resolution ('auto', 'brave', 'mock', 'duckduckgo'). Default is
# 'auto': uses Brave when BRAVE_SEARCH_API_KEY is set, otherwise the deterministic
# synthetic mock (clearly labeled in the UI — never real web research).
# - advanced/mixed setups can pin:  HATHAP_RESEARCH_PROVIDER=brave
# HATHAP_RESEARCH_PROVIDER=auto
# Get a free key at https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=your-brave-search-api-key
